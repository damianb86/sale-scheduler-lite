# Sale Scheduler Lite
# Copy to .env for local development. Do not commit real secrets.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.com
SCOPES=read_products,write_products
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/sale_scheduler_lite
SHOP_CUSTOM_DOMAIN=
NODE_ENV=development

# Docker deployment placeholders
COMPOSE_PROJECT_NAME=sale-scheduler-lite
APP_DB_NAME=sale_scheduler_lite
APP_DB_USER=sale_scheduler_lite_user
APP_DB_PASSWORD=replace_me
APP_HOST=sale-scheduler-lite.example.com
CONTACT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
NODE_OPTIONS=
